# ============================================================
# FDR Portal — Backend environment template
#
# Copy to .env.local (gitignored) and fill in real values.
# Every variable here is read by backend/src/config/index.ts.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_VERSION=1.0.0

# --- Database (MongoDB Atlas) ---
# Atlas URI: mongodb+srv://<user>:<pass>@cluster.xxx.mongodb.net/fdr_portal
# Local: mongodb://localhost:27017/fdr_portal
DATABASE_URL=
MONGODB_DATABASE=fdr_portal

# --- Redis (Upstash or local) ---
# Upstash: rediss://default:<password>@<host>:6379 — the rediss:// scheme enables TLS.
# Optional: the API runs without it (rate limiting falls back to in-memory).
REDIS_URL=

# --- JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))") ---
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=fdr-portal
JWT_AUDIENCE=fdr-portal
# HS256 signs with JWT_SECRET alone; leave the key pair empty unless you switch to RS256.
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- MFA ---
MFA_ISSUER=FDR Portal

# --- Encryption (exactly 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))") ---
ENCRYPTION_KEY=

# --- Cloudinary (document + avatar storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP). Local dev: Mailhog on localhost:1025. Production: SES/Gmail/Postmark SMTP credentials. ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fdr-portal.gov.in
SMTP_SECURE=false

# --- SMS (Twilio; reserved for future OTP delivery) ---
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# --- CORS / URLs ---
# Comma-separated allow-list of frontend origins. Add your Vercel URL(s) here:
# https://fdr-portal.vercel.app,https://fdr-portal-git-main-you.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# --- Refresh cookie. For a cross-site deployment (Vercel + Render) set both: ---
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Rate limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
# Auth is throttled harder; 10/15min by default so a test run cannot lock you out.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# --- OTP / verification ---
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_EXPIRY_HOURS=48

# --- Webhooks ---
WEBHOOK_SECRET=

# --- API keys ---
API_KEY_PREFIX=fdr_

# --- Logging ---
LOG_LEVEL=debug

# --- Feature flags ---
FEATURE_MFA_ENABLED=true
FEATURE_SSO_ENABLED=false
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_API_CONNECTOR_ENABLED=true
